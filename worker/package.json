{
  "name": "worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:init:local": "wrangler d1 execute vpn-list --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute vpn-list --remote --file=schema.sql",
    "db:seed:local": "wrangler d1 execute vpn-list --local --file=seed.sql",
    "db:seed:remote": "wrangler d1 execute vpn-list --remote --file=seed.sql"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241112.0",
    "typescript": "~5.6.3",
    "wrangler": "^3.90.0"
  }
}
